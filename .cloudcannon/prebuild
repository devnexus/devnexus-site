#! /bin/bash

# Refresh CFP data for this build's output (not saved back to the project).
bundle exec jekyll cfp speakers
bundle exec jekyll cfp events
# bundle exec jekyll cfp schedule

# Ask GitHub to run the CFP sync workflow, which commits the files to the repo.
# GH_DISPATCH_TOKEN is set in CloudCannon's build environment variables.
if [ -n "$GH_DISPATCH_TOKEN" ]; then
  curl -fsS -X POST \
    -H "Accept: application/vnd.github+json" \
    -H "Authorization: Bearer $GH_DISPATCH_TOKEN" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    https://api.github.com/repos/devnexus/devnexus-site/dispatches \
    -d '{"event_type":"cfp-sync"}' \
    && echo "CFP sync workflow triggered" \
    || echo "WARNING: could not trigger CFP sync workflow"
else
  echo "GH_DISPATCH_TOKEN not set; skipping CFP sync dispatch"
fi
